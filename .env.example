# Copy to .env.local and fill in real values. Never commit .env.local.

# Backend server
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agentic-storefront

# Razorpay (test-mode keys only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Claude / Anthropic (agent orchestrator tool-use loop)
OPENAI_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Frontend (Vite-style env vars, if frontend needs to know the backend origin)
VITE_API_BASE_URL=http://localhost:4000